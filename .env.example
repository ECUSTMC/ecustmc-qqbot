# QQ 机器人配置
QQBOT_APP_ID=your_qqbot_app_id
QQBOT_APP_SECRET=your_qqbot_app_secret

# 高德天气 API
WEATHER_API_TOKEN=your_amap_weather_key

# 黄历 API（聚合数据）
API_APP_ID=your_juhe_app_id
API_APP_SECRET=your_juhe_app_secret

# MC 服务器配置
MC_SERVERS=server1.example.com,server2.example.com
MC_MCSRVSTAT_SERVERS=server1.example.com
MC_SERVER=your_mc_server_host
MC_RCON_PORT=25575
MC_KEY=your_rcon_password

# ECUST AI 配置
ECUST_API_Key=your_ecust_api_key
ECUST_URL=https://your-ecust-api-url/v1/
ECUST_MODEL=MiniMax-M2.5

# Clawdbot 配置
CLAWDBOT_URL=https://your-clawdbot-url/v1/
CLAWDBOT_API_Key=your_clawdbot_api_key

# Ping 测试 API
TJIT_KEY=your_tjit_api_key

# 三角洲行动密码 API
DELTAFORCE_API_TOKEN=your_deltaforce_api_token

# 空教室查询 API
CLASS_API_KEY=your_classroom_api_key

# AI 功能开关
AI_GROUP_ENABLED=false
AI_DIRECT_ENABLED=false

# 飞书配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# 春节期间运势增强功能开关
SPRING_FESTIVAL_ENABLED=false

# MC整合包投票API配置
MCVOTE_API_URL=https://mcvote.ecustvr.top
MCVOTE_API_TOKEN=your_mcvote_api_token

# 窥屏检测配置
PEEK_IMAGE_URL=https://qqbot.bestzyq.cn/bear.jpg
PEEK_NGINX_LOG=/www/wwwlogs/qqbot.bestzyq.cn.log

# 全量消息调试（true 时把每条被忽略的全量消息也打成 WARNING，用于排查「@了没反应」）
FULL_MESSAGE_DEBUG=false

# ---------------------------------------------------------------------------
# 校园问答：腾讯乐享知识库（https://lexiang.tencent.com/wiki/api/）
# 「默认 @ 机器人」时：先搜一遍群组，再由大模型判断该发群结果还是查知识库
# 凭证在乐享管理后台【开发】-【接口凭证管理】创建，并勾选「AI 助手」接口权限
# ---------------------------------------------------------------------------
LEXIANG_APP_KEY=your_lexiang_app_key
LEXIANG_APP_SECRET=your_lexiang_app_secret
# 发起问答的成员帐号；system-bot 表示匿名（只能读「公开」知识，推荐机器人使用）
LEXIANG_STAFF_ID=system-bot
LEXIANG_BASE_URL=https://lxapi.lexiangla.com
# 问答模式：normal(快) / normal-hy3 / normal-ds-v4-flash / reasoning-hy3(深度思考，慢)
LEXIANG_QA_MODE=normal
# 知识范围，格式 "space:知识库ID,team:团队ID,kb_entry:节点ID"，
# 默认锁死「苏群新生指南」知识库，防止检索跑到授权范围内的其他知识库
LEXIANG_TARGETS=space:19e383358f904015bf1eb3101b2ad332
# 校园问答总开关（缺少上面两个凭据时会自动关闭）
CAMPUS_QA_ENABLED=false
# 路由大模型（判断「找群 / 查知识库 / 走 AI 对话」）—— 独立的一套配置，不与 /ai、/model 共用
# （/model 会在运行时改写 ECUST_MODEL 并写回 .env，共用会让路由模型被换掉）
# 留空则回退到 ECUST_*；建议配一个非推理型模型：
#   hy3 单次约 800 token、3~8s，gemini-3.5-flash-lite 约 28 token、1.2s
# ROUTER_API_KEY=
# ROUTER_URL=https://newapi.bestzyq.cn/v1   # 外网入口；内网是 http://newapi.ecustvr.top/v1
# ROUTER_MODEL=gemini-3.5-flash-lite
# ROUTER_TIMEOUT=10

# 默认 @ 的第三分支：既不是找群、也不是校园问题时，用已有的 /ai 对话回复
# 不开启这两个开关时，该分支会回一句功能提示
AI_GROUP_ENABLED=true
AI_DIRECT_ENABLED=true

